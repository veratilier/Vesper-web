{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vesper-api",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "no_bundle": true,
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "vesper.r-vera.com",
      "custom_domain": true
    },
    {
      "pattern": "api.vesper.r-vera.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vesper-db",
      "database_id": "00f8c1ca-f8a3-47d8-9f08-1fec87ec9f4a"
    },
    {
      "binding": "SHARED_MEMORY_DB",
      "database_name": "memory-db",
      "database_id": "94e8bf24-53d1-4199-8483-e908c10c571b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "vesper-media"
    }
  ],
  "assets": {
    "directory": "dist/client"
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
