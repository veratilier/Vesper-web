+            .filter(|(key, entry)| {
+                is_vesper_recall(key) && entry.kind == AdditionalContextKind::Untrusted
+            })
+            .map(|(key, entry)| {
+                ContextualUserFragment::into(AdditionalContextUserFragment::new(
+                    key.clone(),
+                    entry.value.clone(),
+                ))
+            })
+            .collect()
+    }
