+// Vesper owns this namespace. Recall belongs to the current accepted input, not
+// the append-only transcript or compaction history. Other context is unchanged.
+fn is_vesper_recall(key: &str) -> bool {
+    key.strip_prefix("vesper_memory_").is_some_and(|suffix| {
+        suffix.len() == 3 && suffix.bytes().all(|byte| byte.is_ascii_digit())
+    })
+}
+
 impl AdditionalContextStore {
+    pub(crate) fn vesper_recall_for_request(&self) -> Vec<ResponseItem> {
+        self.values
